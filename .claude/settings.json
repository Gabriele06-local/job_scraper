{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.production)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Write(.env)",
      "Write(.env.production)",
      "Write(.env.*)",
      "Write(**/secrets/**)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(sudo *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(chmod 777 *)"
    ]
  },
  "enableAllProjectMcpServers": true
}
