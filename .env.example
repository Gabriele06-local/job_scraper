# ---------------------------------------------------------------
# DevBoards Import Service — Environment Variables
# Copy to .env and fill in required values.
# ---------------------------------------------------------------

# --- MongoDB ---
# Full URI including DB name. Required.
DATABASE_URL="mongodb://localhost:27017/itjobhub"
# DB name used by pymongo client. Must match DATABASE_URL.
MONGO_DB="itjobhub"

# --- Groq AI (REQUIRED) ---
# Get key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_...your-groq-api-key-here"
# Model to use for classification. llama-3.1-8b-instant is fastest + cheapest.
GROQ_MODEL="llama-3.1-8b-instant"
# Max output tokens per call. 1024 is sufficient for the classification schema.
GROQ_MAX_TOKENS=1024
# Temperature. Keep low (0.0–0.2) for deterministic JSON output.
GROQ_TEMPERATURE=0.1
# Request timeout in seconds.
GROQ_TIMEOUT=30
# Client-side rate limit (requests/minute). Free tier limit is 30 RPM.
GROQ_RPM=30

GEMINI_API_KEY="AIza..."

# --- Logging ---
# structlog level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL="INFO"

# --- Adzuna (optional — connector skips if empty) ---
# Register at: https://developer.adzuna.com/ (free, 1000 calls/month)
ADZUNA_APP_ID="your-adzuna-app-id-here"
ADZUNA_APP_KEY="your-adzuna-app-key-here"

# --- Jooble (optional) ---
JOOBLE_API_KEY=""

# --- Reed (optional — UK-focused, requires free account) ---
# Register at: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=""

# --- The Muse (optional — requires free account) ---
# Register at: https://www.themuse.com/developers
THEMUSE_API_KEY=""

# --- CareerJet (optional — free tier, covers IT/ES/DE/FR/GB) ---
# Register at: https://www.careerjet.com/partners/api/ (free affiliate account)
CAREERJET_API_KEY=""

# --- JSearch via RapidAPI (optional — global aggregator: LinkedIn/Indeed/ZipRecruiter) ---
# Subscribe to the JSearch API on RapidAPI (free tier = 150 calls/month):
#   https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Then copy the X-RapidAPI-Key from the endpoint dashboard.
RAPIDAPI_KEY=""

# No key required: Himalayas, Remotive, RemoteOK, Arbeitnow,
#                  Greenhouse, Lever, Ashby, Personio

# --- Google Maps (optional — used for geocoding) ---
GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"

# --- Search config ---
# Comma-separated ISO language codes to scrape.
SCRAPE_LANGUAGES="it,en,es,fr,de"
# Comma-separated keywords to search per connector.
# SCRAPE_KEYWORDS="software engineer,developer,devops"

# --- Connector control ---
# Comma-separated connector names to disable at runtime.
# DISABLED_CONNECTORS="jooble,reed"

# --- Expiration checker ---
# Parallel HEAD probes at once.
EXPIRATION_CONCURRENCY=10
# Max jobs to probe per run (0 = use this setting as default).
EXPIRATION_LIMIT=500
# Jobs older than this (never probed) are force-expired without HTTP probe.
EXPIRATION_MAX_AGE_DAYS=60
# User-Agent sent during link probes.
EXPIRATION_USER_AGENT="DevBoardsLinkProbe/1.0 (+https://devboards.io/probe)"

# --- Health check ---
# Path where CLI writes last-run JSON (used for container health probes).
HEALTH_CHECK_FILE="/tmp/health.json"

# --- Docker scheduling (docker-compose only) ---
# Sleep between importer runs (seconds). Default: 4h.
IMPORT_INTERVAL_SECONDS=14400
# Sleep between expirer runs (seconds). Default: 24h.
EXPIRE_INTERVAL_SECONDS=86400

# --- Legacy (unused by new pipeline — kept for main.py compatibility) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
